# RESEND_API_KEY: API key from https://resend.com for sending order emails
RESEND_API_KEY="re_123456789"

# ORDER_RECEIVER_EMAIL: The business owner's email address where customer orders will be sent
ORDER_RECEIVER_EMAIL="orders@qualityfruits.example.com"

# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

